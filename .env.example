# Shared defaults for local development
DATABASE_URL=postgresql://decolonia:decolonia@localhost:5433/decolonia_office
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
API_PORT=3001

# Production deployment (Vercel + Supabase)
# DATABASE_URL is set per Vercel environment:
# - Preview (main branch): Supabase dev pooler URL with ?pgbouncer=true
# - Production (prod branch): Supabase prod pooler URL with ?pgbouncer=true

# Developer-only secrets for running migrations (never set in Vercel)
# Retrieve these from Supabase project Settings → Database → Connection String (port 5432)
DEV_DIRECT_URL=postgresql://postgres:[password]@db.[dev-project-ref].supabase.co:5432/postgres
PROD_DIRECT_URL=postgresql://postgres:[password]@db.[prod-project-ref].supabase.co:5432/postgres
