{
  "name": "decolonia-office",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "pnpm install",
    "dev": "pnpm dev:infra && pnpm dev:apps",
    "dev:infra": "docker compose up -d postgres",
    "stop:infra": "docker compose down",
    "dev:apps": "turbo run dev --parallel --filter=@decolonia/web",
    "build": "turbo run build --filter=@decolonia/web",
    "check": "turbo run check --filter=@decolonia/web",
    "verify:connectivity": "pnpm --filter @decolonia/web health:check"
  },
  "devDependencies": {
    "turbo": "^2.0.14"
  }
}
