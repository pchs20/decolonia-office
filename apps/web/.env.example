DATABASE_URL=postgresql://decolonia:decolonia@localhost:5433/decolonia_office
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
AUTO_RUN_MIGRATIONS=true

# Auth.js (Google OAuth)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=your-secret-here
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Comma-separated list of allowed email addresses
ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com

# Google Drive backup shared personal folder
# Create this folder in the canonical worker's My Drive and share it with the other worker.
GOOGLE_DRIVE_SHARED_FOLDER_ID=your-shared-folder-id
